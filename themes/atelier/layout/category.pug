extends partial/layout

block append vars
  - bodyClass = 'page-read'
  - listTitle = 'Blogs'


block site_title
    = page.category + " · " + config.title


block content
  .reader
    include partial/reader-list
    section.reader-article
      .panel
        .panel-bar
          span.panel-dot(aria-hidden="true")
          h1.panel-title= page.category
        .panel-body.article-scroll
          article.post-content
            header.post-header
              h2.post-title= '分类：' + page.category
              p.post-meta= page.posts.length + ' 篇'
            ul.term-list
              - page.posts.sort('date', -1).each(function(post){
                li
                  time= date(post.date, 'YYYY-MM-DD')
                  = ' '
                  a(href=url_for(post.path))= post.title
              - })
