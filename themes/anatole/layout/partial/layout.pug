doctype
html(lang="zh-CN")
  head
    include head

  body
    include sidebar
    .main
      include nav

      block content

    script(src= url_for('js/jquery.js'))
    script(src= url_for('js/jquery-migrate-1.2.1.min.js'))
    script(src= url_for('js/jquery.appear.js'))
    if page.content && page.content.indexOf('mermaid') > -1
      script(type="module").
        import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs';
        document.querySelectorAll('pre > code.mermaid, pre.mermaid > code').forEach(function(c){var d=document.createElement('pre');d.className='mermaid';d.textContent=c.textContent;c.parentNode.replaceWith(d);});
        mermaid.initialize({startOnLoad:false});
        for (const el of document.querySelectorAll('pre.mermaid')) { await mermaid.run({nodes:[el]}); }
