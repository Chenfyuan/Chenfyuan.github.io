.page-top.animated.fadeInDown
  .nav
    li
      a(class=is_home() ? 'current' : '', href=url_for('/'))= __('Home')
    li
      a(class=is_archive() ? 'current' : '', href=url_for('/archives/'))= __('Archive')
    li
      a(class=(is_current('categories') || is_category()) ? 'current' : '', href=url_for('/categories/'))= __('Categories')
    li
      a(class=(is_current('tags') || is_tag()) ? 'current' : '', href=url_for('/tags/'))= __('Tags')
  .information
    .back_btn
      li
        if is_post()
          a.fa.fa-chevron-left(onclick="window.history.go(-1)") 
        else
          a.fa.fa-chevron-left(onclick="window.history.go(-1)",style="display:none;") 
    .avatar
      img(src=url_for(theme.avatar))
